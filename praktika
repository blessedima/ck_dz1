import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.stats import alpha

iris = sns.load_dataset('iris')

from sklearn.decomposition import PCA

iris_two = iris[iris['species'].isin(['setosa', 'versicolor'])]
X = iris_two.drop('species', axis=1)
y = iris_two['species']

model = PCA()
X_pca = model.fit_transform(X)

plt.figure(figsize=(8, 6))
for target, color in zip(['setosa', 'versicolor'], ['red', 'green']):
    mask = y == target
    plt.scatter(X_pca[mask, 0], X_pca[mask, 1], c=color, label=target, alpha=0.7, edgecolor='k')
plt.xlabel('первая главная компонента')
plt.ylabel('вторая главная компонента')
plt.title('PCA двух сортов ириса')
plt.legend()
plt.grid(True)
# # plt.show()

from sklearn.ensemble import RandomForestClassifier

X_rf = iris_two.iloc[:, 0:2].to_numpy()
y_rf = iris_two['species']

model = RandomForestClassifier()
model.fit(X_rf, y_rf)

xx, yy = np.meshgrid(
    np.linspace(X_rf[:, 0].min() - 0.5, X_rf[:, 0].max() + 0.5, 200),
    np.linspace(X_rf[:, 1].min() - 0.5, X_rf[:, 1].max() + 0.5, 200)
)

Z = model.predict(np.c_[xx.ravel(), yy.ravel()])
Z = (Z == 'versicolor').astype(int)
Z = Z.reshape(xx.shape)

plt.figure(figsize=(8, 6))
plt.contourf(xx, yy, Z, alpha=0.3, levels=[-0.5, 0.5, 1.5], colors=['red', 'green'])
setosa_mask = y_rf == 'setosa'
versicolor_mask = y_rf == 'versicolor'

plt.scatter(X_rf[setosa_mask, 0], X_rf[setosa_mask, 1], color='red', label='setosa', alpha=0.7, edgecolor='k')

plt.scatter(X_rf[versicolor_mask, 0], X_rf[versicolor_mask, 1], color='green', label='versicolor', alpha=0.7, edgecolor='k')

plt.xlabel('sepal length')
plt.ylabel('sepal width')
plt.title('RandomForestClassifier разделение setosa и versicolor')
plt.legend()
# # plt.show()

from sklearn.cluster import KMeans

X_kmeans = iris_two.iloc[:, 0:2].to_numpy()
true_labels = iris_two['species']

model = KMeans()
model.fit(X_kmeans)
predicted_clusters = model.predict(X_kmeans)

plt.figure(figsize=(12, 5))

plt.subplot(1, 2, 1)
plt.scatter(X_kmeans[:, 0], X_kmeans[:, 1], c=predicted_clusters, cmap='coolwarm', alpha=0.7, edgecolor='k')
plt.scatter(model.cluster_centers_[:, 0], model.cluster_centers_[:, 1], marker='X', s=200, c='black', label='центры кластеров')
plt.xlabel('sepal length')
plt.ylabel('sepal width')
plt.title('KMeans предсказанные кластеры')
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
for target, color in zip(['setosa', 'versicolor'], ['red', 'green']):
    mask = true_labels == target
    plt.scatter(X_kmeans[mask, 0], X_kmeans[mask, 1], c=color, label=target, alpha=0.7, edgecolor='k')
plt.xlabel('sepal length')
plt.ylabel('sepal width')
plt.title('истинные сорта (для сравнения)')
plt.legend()
plt.grid(True)

plt.tight_layout()
plt.show()

