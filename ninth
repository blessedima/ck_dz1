w1 = np.where(df.index.weekday < 5, "Будни", "Выходные")
t1 = df.groupby([w1, df.index.time]).mean()
fig, ax = plt.subplots(1, 2)
ax[0].set_ylim(0, 600)
t1.loc["Будни"].plot(ax = ax[0], title = "Будни")
ax[1].set_ylim(0, 600)
t1.loc["Выходные"].plot(ax = ax[1], title = "Выходные")

