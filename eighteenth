import numpy as np
import math
import matplotlib.pyplot as plt
import random


# метод средней точки, вариант 2
# y' + y * tg(x) = 1/cos(x), [a, b] = [0, 1.5], y(a) = 1, y = sin(x) + cos(x)

def yd_func(x, y):
    return (1 / math.cos(x)) - y * math.tan(x)

def y_func(x):
    return math.sin(x) + math.cos(x)

def perturbation(arr, magnitude=0.03):
    darr = []
    for i in range(len(arr)):
        darr.append(arr[i] * (1 - 2 * random.random()) * magnitude)
    arr_star = np.add(arr, darr)
    return darr, arr_star

a, b, y0, n = 0, 1.5, 1, 20
h = (b - a) / n
y_tochn = []
x_znach = np.arange(a, b + h, h)
y_znach = np.zeros(n + 1)


def MSrT(a, b, y0, n, x_znach, y_znach):
    y_znach[0] = y0
    h = (b - a) / n
    for i in range(n):
        x_n = x_znach[i]
        y_n = y_znach[i]
        f_i = yd_func(x_n + h / 2, y_n + (h / 2) * yd_func(x_n, y_n))
        y_znach[i + 1] = y_n + h * f_i
        y_tochn.append(y_func(x_n))
    return x_znach, y_znach


x_znach, y_znach = MSrT(a, b, y0, n, x_znach, y_znach)
y_tochn.append(y_func(x_znach[-1]))
y_tochn_fixed = y_tochn.copy()

y_errors = []
for i in range(len(x_znach)):
    y_errors.append(abs(y_znach[i] - y_func(x_znach[i])))

plt.figure(figsize=(10, 5))
plt.plot(x_znach, y_znach, 'b-', label='найденные решения', markersize=4)
plt.plot(x_znach, y_tochn_fixed, 'r--', label='точное решение')
plt.xlabel('x')
plt.ylabel('y')
plt.title("решение методом средней точки")
plt.legend()
plt.grid(True)

eps1 = abs(y_func(x_znach[0]) - y_znach[0])
epsn = abs(y_func(x_znach[-1]) - y_znach[-1])

plt.figure(figsize=(10, 5))
plt.plot(x_znach, y_errors, 'b-', markersize=4)
plt.scatter(x_znach[0], eps1, color='blue', marker='o', label='локальная погрешность')
plt.scatter(x_znach[-1], epsn, color='red', marker='o', label='глобальная погрешность')
plt.xlabel('x')
plt.ylabel('y')
plt.title("ошибка")
plt.legend()
plt.grid(True)

loc_pogr = []
glob_pogr = []
n_values = [25, 50, 100, 200, 400, 800]
h_values = [(b - a) / n for n in n_values]

for n in n_values:
    h_n = (b - a) / n
    x_n = np.arange(a, b + h_n, h_n)      # новый массив x для данного n
    y_n = np.zeros(n + 1)                 # новый массив y
    x_res, y_res = MSrT(a, b, y0, n, x_n, y_n)
    loc_pogr.append(abs(y_func(x_res[1]) - y_res[1]))
    glob_pogr.append(abs(y_func(x_res[-1]) - y_res[-1]))

# Построение зависимости погрешностей от шага
plt.figure(figsize=(10, 5))
plt.loglog(h_values, loc_pogr, 'bo-', label='локальная погрешность')
plt.loglog(h_values, glob_pogr, 'ro-', label='глобальная погрешность')
plt.xlabel('шаг h')
plt.ylabel('погрешность')
plt.title('зависимость погрешностей от шага')
plt.legend()
plt.grid(True)

n = 20
magnitudes = [0, 1e-5, 1e-4, 1e-3, 0.01, 0.05, 0.1]
global_errors_perturbed = []

plt.figure(figsize=(10, 5))
for mag in magnitudes:
    y_tochn.clear()

    _, y0_star_arr = perturbation([y0], magnitude=mag)
    y0_pert = y0_star_arr[0]

    y_znach_pert = np.zeros(n + 1)
    x_pert, y_znach_pert = MSrT(a, b, y0_pert, n, x_znach.copy(), y_znach_pert)

    err_global = abs(y_znach_pert[-1] - y_tochn_fixed[-1])
    global_errors_perturbed.append(err_global)

    if mag != 0:
        plt.plot(x_pert, y_znach_pert, label=f'возмущение magnitude={mag}')
    else:
        plt.plot(x_pert, y_znach_pert, 'k-', linewidth=2, label='без возмущения')

plt.plot(x_znach, y_tochn_fixed, 'r--', linewidth=2, label='точное решение')
plt.xlabel('x')
plt.ylabel('y')
plt.title("влияние ошибок в начальных данных")
plt.legend(loc='best')
plt.grid(True)

plt.figure(figsize=(10, 5))
non_zero_mag = [m for m in magnitudes if m != 0]
non_zero_err = [global_errors_perturbed[i] for i, m in enumerate(magnitudes) if m != 0]
plt.loglog(non_zero_mag, non_zero_err, 'bo-', linewidth=2, markersize=8)
plt.xlabel('уровень возмущения')
plt.ylabel('глобальная ошибка')
plt.title('чувствительность решения к ошибке в начальных данных')
plt.grid(True, which='both', linestyle='--')

plt.show()
